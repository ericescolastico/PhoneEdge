#include <winuser.h>

1 RT_MANIFEST "phoneedge-windows.manifest"
2 VERSIONINFO
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "FileDescription", "Mouse e teclado do PC para o celular Android (fork do scrcpy)"
      VALUE "InternalName", "phoneedge"
      VALUE "LegalCopyright", "Romain Vimont, Genymobile (scrcpy); modificacoes PhoneEdge"
      VALUE "OriginalFilename", "phoneedge.exe"
      VALUE "ProductName", "PhoneEdge"
      VALUE "ProductVersion", "0.1.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
